# ==============================================================================
# ENTERPRISE QA AUTOMATION & QAOPS PIPELINE — CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Скопируйте данный файл в .env и укажите ваши корпоративные учетные данные:
#   cp .env.example .env
#
# Все параметры сгруппированы по сервисам с подробными комментариями и форматами.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. JIRA CLOUD / ATLaSSIAN SUITE
# ------------------------------------------------------------------------------
# Базовый URL вашей организации в Atlassian Cloud (например, https://company.atlassian.net)
ATLASSIAN_BASE_URL=https://your-company.atlassian.net

# Email пользователя или сервисного аккаунта с правами управления тикетами
ATLASSIAN_USER_EMAIL=qa-automation@your-company.com

# API-токен Atlassian (создается в https://id.atlassian.com/manage-profile/security/api-tokens)
ATLASSIAN_API_TOKEN=your_atlassian_api_token_here

# Префикс ключа задач вашего проекта (например, JS, PROJ, CRM)
JIRA_PROJECT_KEY=JS

# (Опционально) Ключ родительского эпика для автотестов
JIRA_EPIC_KEY=JS-1

# Базовый URL Confluence (обычно совпадает с ATLASSIAN_BASE_URL)
CONFLUENCE_BASE_URL=https://your-company.atlassian.net/wiki

# Ключ пространства Confluence со спецификациями требований
CONFLUENCE_SPACE_KEY=QA


# ------------------------------------------------------------------------------
# 2. N8N ORCHESTRATION PLATFORM
# ------------------------------------------------------------------------------
# Внутренний или внешний URL инстанса n8n (без завершающего слеша)
N8N_URL=http://your-n8n-host:5678
N8N_SERVER_URL=http://your-n8n-host:5678

# API-ключ n8n (создается в n8n -> Settings -> API Keys)
N8N_API_KEY=your_n8n_api_key_here

# Идентификатор основного рабочего процесса Juice Shop / QA Pipeline в n8n
N8N_WORKFLOW_ID=Dv1WydaTMC1lxR0E

# Идентификатор сохраненных учетных записей Jira в n8n (Credentials ID)
N8N_JIRA_CRED_ID=your_n8n_jira_cred_id

# Идентификатор сохраненных учетных записей Gemini/OpenAI в n8n
N8N_GEMINI_CRED_ID=your_n8n_gemini_cred_id

# Внешний URL туннеля или ингресса (ngrok / reverse proxy) для приема входящих вебхуков Jira
NGROK_URL=https://your-domain.ngrok-free.dev


# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT ALERTS & HITL NOTIFICATIONS
# ------------------------------------------------------------------------------
# Токен бота Telegram (получается у @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_12345678

# Имя пользователя бота (например, my_company_qa_bot)
TELEGRAM_BOT_USERNAME=your_qa_bot

# Идентификатор чата, группы или канала команды QA (куда отправлять алерты и сводки)
# Для групп со знаком минус (например, -100123456789)
TELEGRAM_CHAT_ID=-100123456789


# ------------------------------------------------------------------------------
# 4. QASE TMS (TEST MANAGEMENT SYSTEM)
# ------------------------------------------------------------------------------
# API-токен Qase TMS (создается в https://app.qase.io/user/api/tokens)
QASE_API_TOKEN=your_qase_api_token_here

# Код проекта в Qase TMS (латинские буквы, например JS, SHOP, CORE)
QASE_PROJECT_CODE=JS

# Базовый URL Qase API
QASE_API_URL=https://api.qase.io/v1

# URL интерфейса проекта Qase для ссылок в тикетах
QASE_PROJECT_URL=https://app.qase.io/project/JS


# ------------------------------------------------------------------------------
# 5. LLM PROVIDERS & EVALUATION (PROMPTOPS)
# ------------------------------------------------------------------------------
# Ключ Google AI Studio / Gemini API (создается в https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Название используемой модели Gemini (по умолчанию: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# (Опционально) Токен OpenAI, если используется альтернативный провайдер
OPENAI_API_KEY=

# (Опционально) Ключ DeepEval для расширенных метрик оценки тестов
DEEPEVAL_API_KEY=

# Версионирование промптов (PromptOps) — оставьте пустым для enterprise v2.0 по умолчанию
# Доступные значения: v1.0_baseline | v2.0_enterprise | кастомные версии
PROMPT_VERSION_DOR_EVALUATION=v2.0_enterprise
PROMPT_VERSION_TEST_DESIGN_AUDIT=v2.0_enterprise
PROMPT_VERSION_CODE_REVIEW_AUDIT=v2.0_enterprise
PROMPT_VERSION_DELTA_REFINEMENT=v2.0_enterprise


# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & TELEMETRY (LANGFUSE & SENTRY)
# ------------------------------------------------------------------------------
# Langfuse Tracing (создается в https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=your_project_id

# Sentry Crash Monitoring & MCP Server
# DSN проекта Sentry для автоматического перехвата необработанных исключений
SENTRY_DSN=
# Имя организации в Sentry
SENTRY_ORG=your-sentry-org
# URL интеграции Sentry MCP (Model Context Protocol)
SENTRY_MCP_URL=https://mcp.sentry.dev/mcp/your-sentry-org


# ------------------------------------------------------------------------------
# 7. GITHUB ACTIONS CI/CD
# ------------------------------------------------------------------------------
# Personal Access Token GitHub с правами 'repo' и 'workflow' для workflow_dispatch
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Репозиторий с раннером автотестов (owner/repo)
GITHUB_REPOSITORY=Romeo-Timony/juice-qa

# Имя YAML-файла workflow в .github/workflows/
GITHUB_WORKFLOW_ID=autotests.yml


# ------------------------------------------------------------------------------
# 8. SUT (SYSTEM UNDER TEST) & TESTING ENVIRONMENT
# ------------------------------------------------------------------------------
# URL тестируемого приложения (OWASP Juice Shop или целевая система)
JUICE_SHOP_LOCAL_URL=http://localhost:3000

# URL удаленного кластера браузеров (Browserless / Playwright remote)
BROWSERLESS_URL=ws://your-browserless-host:3000

# WireMock standalone URL для мок-сервера и fault injection
WIREMOCK_URL=http://127.0.0.1:8080


# ------------------------------------------------------------------------------
# 9. ENTERPRISE DATABASE (EVENT STORE & OUTBOX)
# ------------------------------------------------------------------------------
# По умолчанию используется локальный высокоскоростной SQLite WAL режим:
# data/qa_pipeline.db
#
# Для развертывания в корпоративном PostgreSQL 16 раскомментируйте строку ниже:
# DATABASE_URL=postgresql://qa_user:qa_password@postgres-host:5432/qaops_db


# ------------------------------------------------------------------------------
# 10. QAOPS QUALITY GATES THRESHOLDS (HARD GATES)
# ------------------------------------------------------------------------------
# Минимальный порог целостности тест-дизайна (0.0..1.0, по умолчанию 0.90)
QAOPS_DESIGN_INTEGRITY_MIN=0.90

# Минимальный порог обоснованности тестов к AC (0.0..1.0, по умолчанию 0.80)
QAOPS_GROUNDEDNESS_MIN=0.80
