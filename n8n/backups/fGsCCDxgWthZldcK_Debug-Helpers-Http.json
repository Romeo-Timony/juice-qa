        "jsCode": "\nlet log = [];\ntry {\n  log.push(\"helpers keys: \" + Object.keys(this.helpers).join(\", \"));\n  const res = await this.helpers.httpRequest({\n    method: \"POST\",\n    url: \"https://api.qase.io/v1/suite/JS\",\n    headers: {\n      \"Token\": \"a1afdd5f4fde689caed49e78d3c8e998b4ad94946ddb9770c2ac4d7a4476aa23\",\n      \"Content-Type\": \"application/json\"\n    },\n    body: { title: \"Frontend\" },\n    json: true\n  });\n  log.push(\"result: \" + JSON.stringify(res));\n} catch (e) {\n  log.push(\"error: \" + e.message);\n}\nreturn [{ json: { log } }];\n"
