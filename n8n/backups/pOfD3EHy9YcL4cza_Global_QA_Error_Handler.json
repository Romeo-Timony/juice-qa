    {
      "id": "err-format-code-02",
      "name": "Format Error Card",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "\nconst err = $json.execution?.error || {};\nconst wf = $json.workflow || {};\nconst exec = $json.execution || {};\n\nconst wfName = wf.name || 'Unknown Workflow';\nconst lastNode = err.node?.name || err.lastNodeExecuted || 'Unknown Node';\nconst errMsg = err.message || 'Unhandled error occurred';\nconst execId = exec.id || 'N/A';\nconst execUrl = `${exec.url || 'http://201.34.147.33:5678/execution/' + execId}`;\n\nconst text = `🚨 <b>[n8n FLOW FAILURE] Сбой в оркестраторе QA</b>\\n\\n` +\n  `📁 <b>Воркфлоу:</b> ${wfName}\\n` +\n  `🛑 <b>Упавший узел:</b> <code>${lastNode}</code>\\n` +\n  `🆔 <b>Execution ID:</b> <code>#${execId}</code>\\n\\n` +\n  `💬 <b>Ошибка:</b>\\n<code>${errMsg.substring(0, 500)}</code>\\n\\n` +\n  `🔗 <a href=\"${execUrl}\"><b>👉 Открыть упавший прогон в n8n</b></a>`;\n\nreturn [{ json: { text, chat_id: '1434200911' } }];\n"
      }
    },
    {
      "id": "err-tg-send-03",
      "name": "Telegram: Send Error Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8463540623:AAHmW9uuff8C_XQDk4cLby1GoVyc7-zo4Ek/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.text, parse_mode: 'HTML', disable_web_page_preview: true }) }}"
      }
    }
  ],
